{
  "version": 2,
  "builds": [
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "templates/**",
          "static/**",
          "entity_parser.py",
          "app.py"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/robots.txt", "dest": "/public/robots.txt" },
    { "src": "/sitemap.xml", "dest": "/public/sitemap.xml" },
    { "src": "/opensearch.xml", "dest": "/public/opensearch.xml" },
    { "src": "/manifest.json", "dest": "/public/manifest.json" },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
