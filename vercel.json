{
  "version": 2,
  "ignoreCommand": "if [ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ]; then exit 0; else exit 1; fi",
  
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "includeFiles": [
          "templates/**",
          "static/**",
          "osint/**",
          "retrieval/**",
          "api_v1.py",
          "billing.py",
          "cli/README.md",
          "bot_crawler.py",
          "entity_parser.py",
          "google_oauth.py",
          "people_finder.py",
          "query_understanding.py",
          "reverse_image.py",
          "reverse_image_storage.py",
          "research_chat.py",
          "search_routing.py",
          "seo_copy.py",
          "search_bots.py",
          "search_protocol.py",
          "startup_checks.py",
          "unfiltered_engagement.py",
          "app.py"
        ]
      }
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.abbieysearch.com"
        }
      ],
      "destination": "https://abbieysearch.com/$1",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
