#!/bin/sh
# Validate git send-email patches for this repository.
# Enable: cp .githooks/sendemail-validate .git/hooks/sendemail-validate && chmod +x .git/hooks/sendemail-validate

fail() {
	printf '%s\n' "sendemail-validate: error: $*" >&2
	return 1
}

validate_cover_letter() {
	file="$1"
	test -s "$file" || fail "cover letter is empty"

	if rg -n -i "(TODO|FIXME|WIP|TBD)" "$file" >/dev/null 2>&1
	then
		fail "cover letter contains unresolved TODO/FIXME/WIP/TBD markers"
	fi
}

validate_patch() {
	file="$1"
	# Ensure that the patch applies without conflicts.
	git am -3 "$file" || return

	# Fail if the new commit introduces whitespace errors.
	git diff-tree --check --no-commit-id --root -r HEAD >/dev/null ||
		fail "patch introduces whitespace errors"

	# Keep patch emails review-ready by rejecting unresolved todo markers.
	if git show --pretty= --unified=0 HEAD | rg -n -i "^\+.*(TODO|FIXME|XXX|TBD)" >/dev/null 2>&1
	then
		fail "patch introduces unresolved TODO/FIXME/XXX/TBD marker"
	fi
}

validate_series() {
	# Quick repository-level smoke check for Python syntax errors.
	python_bin=
	if command -v python >/dev/null 2>&1
	then
		python_bin=python
	elif command -v python3 >/dev/null 2>&1
	then
		python_bin=python3
	fi

	if test -n "$python_bin"
	then
		"$python_bin" -m compileall -q app.py engine retrieval osint scripts >/dev/null 2>&1 ||
			fail "python compile smoke check failed"
	else
		printf '%s\n' "sendemail-validate: warning: python/python3 not found; skipping compile smoke check" >&2
	fi
}

# main -------------------------------------------------------------------------

if test "$GIT_SENDEMAIL_FILE_COUNTER" = 1
then
	remote=$(git config --default origin --get sendemail.validateRemote) &&
	ref=$(git config --default HEAD --get sendemail.validateRemoteRef) &&
	worktree=$(mktemp --tmpdir -d sendemail-validate.XXXXXXX) &&
	git worktree add -fd --checkout "$worktree" "refs/remotes/$remote/$ref" &&
	git config --replace-all sendemail.validateWorktree "$worktree"
else
	worktree=$(git config --get sendemail.validateWorktree)
fi || {
	echo "sendemail-validate: error: failed to prepare worktree" >&2
	exit 1
}

unset GIT_DIR GIT_WORK_TREE
cd "$worktree" &&

if rg -q "^diff --git " "$1"
then
	validate_patch "$1"
else
	validate_cover_letter "$1"
fi &&

if test "$GIT_SENDEMAIL_FILE_COUNTER" = "$GIT_SENDEMAIL_FILE_TOTAL"
then
	git config --unset-all sendemail.validateWorktree &&
	trap 'git worktree remove -ff "$worktree"' EXIT &&
	validate_series
fi
