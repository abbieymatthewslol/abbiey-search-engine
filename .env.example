# abbiey.search — environment configuration
#
# EASIEST (local + Supabase): run once — only your DB password needed
#   python scripts/setup_supabase_env.py
#   or double-click: setup_supabase.bat
#
# Or copy this file to .env and edit by hand.

# Flask secret key (generate a random one for production)
SECRET_KEY=change-me-to-something-random-and-long

# Signup email verification (Resend — https://resend.com). Without this, verification emails are not sent
# (OTP + link are logged server-side as a warning). After verifying your domain in Resend, set FROM to match.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=abbiey.search <noreply@yourdomain.com>

# Public site URL (no trailing slash) — used for Open Graph, Twitter cards, JSON-LD, Stripe return
# resolution, and Supabase OAuth / password-reset redirectTo (must match Supabase Auth URL config).
# If unset, the current request origin is used (set SITE_URL on Vercel/production so Google sign-in
# returns to your real domain, not a preview URL).
# SITE_URL=https://abbieysearch.com
# Legacy alias used by health checks and share-link helpers. Prefer SITE_URL, but keep
# the same value if you use it:
# CANONICAL_URL=https://abbieysearch.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for /api/ endpoints.
# Defaults to SITE_URL if unset. Set explicitly in production to avoid open CORS.
# CORS_ALLOWED_ORIGINS=https://abbieysearch.com,https://www.abbieysearch.com

# ── Google Search Console ─────────────────────────────────────────────────────
# Set your domain verification token from Google Search Console → HTML tag method.
# Leave unset or empty to omit the meta tag.
# GOOGLE_SITE_VERIFICATION=your-verification-token

# ── Google Analytics 4 (gtag.js) ──────────────────────────────────────────────
# Defaults to G-FG3G7DRBW1 when unset. Set your own GA4 measurement ID, or set empty
# to disable gtag (recommended for private/self-hosted installs):
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GOOGLE_ANALYTICS_ID=

# ── Google AdSense (optional display ads) ─────────────────────────────────────
# Publisher ID from AdSense → Account → Account information. Create ad units for placements.
# GOOGLE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
# Optional fixed slots (display / responsive units from AdSense → Ads → By ad unit):
# GOOGLE_ADSENSE_SLOT_HOME=1234567890
# GOOGLE_ADSENSE_SLOT_RESULTS=0987654321
# If only GOOGLE_ADSENSE_CLIENT is set, you can still enable Auto ads in the AdSense dashboard.

# ── Support / tip link (optional — shown in site footer) ───────────────────────
# SUPPORT_URL=https://ko-fi.com/yourpage

# ── Community links (required in production; shown on /community + footer) ────
# Short Discord invite URL:
# COMMUNITY_DISCORD_URL=https://discord.gg/your-invite
# Public Matrix room (matrix.to link):
# COMMUNITY_MATRIX_URL=https://matrix.to/#/#abbieysearch:matrix.org
# GitHub repository:
# COMMUNITY_GITHUB_URL=https://github.com/abbieymatthewslol/abbiey-search-engine-2

# ── Data region (shown in /privacy, /status, and footer) ──────────────────────
# One of: sg, eu, us, local. Drives the human label without a code change when
# you move your Supabase project between regions.
# ABBIEY_DATA_REGION=sg

# ── Stripe (API keys + /api/v1 billing) ──────────────────────────────────────
# Payment links have no hardcoded defaults in code.
# API keys checkout URL (Developer hub "Buy API access"):
STRIPE_API_KEYS_CHECKOUT_URL=https://buy.stripe.com/your-link
# Server-side Stripe API key for metered /api/v1 billing:
# STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxx
# Advanced metering knobs for /api/v1 usage:
# ABBIEY_STRIPE_METER_EVENT=api_v1_request
# ABBIEY_API_V1_FREE_MONTHLY=1000
# ABBIEY_API_V1_RATE=120/minute
# ABBIEY_BILLING_FLUSH_EVERY=25
# ABBIEY_BILLING_FLUSH_SECONDS=60

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects /admin/analytics — visit /admin/analytics?token=YOUR_TOKEN
ADMIN_TOKEN=change-me-to-something-secret

# ── Feature gates (config-driven, no-redeploy) ────────────────────────────
# Each gate controls who can use a feature:
#   "all"  — available to everyone (default)
#   "paid" — reserved for paid-only gating if you self-host with a separate unlock system
#   "none" — disabled for everyone (kill-switch)
# FEATURE_DEEP_WEB=all
# FEATURE_AI_SUMMARY=all
# FEATURE_AI_CHAT=all
# FEATURE_CODE_SEARCH=all
# FEATURE_VOICE_SEARCH=all
# FEATURE_ANSWER_LAYER=all

# ── OSINT (optional public signals: DNS / RDAP / PTR / TLS / Kali-style CLI) ──
# Master switch (unset = enabled). Set to 0/false/off to hide UI and disable POST /api/osint/enrich.
# ABBIEY_OSINT_ENABLED=1
# Comma-separated module whitelist:
#   dns, rdap, ptr — default trio (DoH + RDAP + system PTR for IPv4)
#   tls — live TLS certificate metadata (Python ssl + cryptography, port 443)
#   dig, whois — only when those binaries exist on PATH (typical on Kali / Debian with dnsutils, whois)
# Example for local Kali-style dev:
# ABBIEY_OSINT_MODULES=dns,rdap,ptr,tls,dig,whois
# ABBIEY_OSINT_MODULES=dns,rdap,ptr

# ── Open access (self-host) ───────────────────────────────────────────────────
# Set to 1/true to disable all rate limits — only on networks you trust.
# ABBIEY_OPEN_ACCESS=1
# Max search / chat message length in characters (500–50000, default 8000).
# ABBIEY_MAX_QUERY_LENGTH=8000
# Welcome gate for GET / : 1 = go straight to /search; 0 = send new visitors to /welcome first.
# If unset: local dev defaults to /welcome first; Vercel (VERCEL=1) defaults to /search (SEO).
# ABBIEY_SKIP_WELCOME_SCREEN=1

# Multi-source retrieval pipeline for web text search (async fan-out, scoring, dedup, optional clusters).
# Set to 0/false/off to use the legacy DDG + thread-pool enrichment path only.
# ABBIEY_RETRIEVAL_PIPELINE=1
# Intent-aware ranking toggle (1 = on, 0 = off).
# ABBIEY_INTENT_RANKING=1

# ── Exa Search API (optional neural/keyword blend alongside DuckDuckGo) ───────
# When set, web text and news searches blend Exa's semantic results with DDG and
# other open sources, which keeps ranking closer to what the user actually asked
# for (neutral by default, not skewed toward community criticism). Leave unset
# to disable — the engine keeps working with DDG + open catalogues only.
# Get a key at https://dashboard.exa.ai
# EXA_API_KEY=exa_xxxxxxxxxxxxxxxx

# Optional: tune retrieval ranking weights (defaults: 0.25 / 0.35 / 0.40).
# ABBIEY_SCORE_W_FRESHNESS=0.25
# ABBIEY_SCORE_W_AUTHORITY=0.35
# ABBIEY_SCORE_W_SEMANTIC=0.40

# ── AI providers (optional) ──────────────────────────────────────────────────────
# Local Ollama:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OpenAI-compatible API:
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ── Supabase (PostgreSQL + Auth) — persistent users, bookmarks, analytics ──
#
# ACTIVE PROJECT: xwxscvllmghyogddpmii (Singapore, ap-southeast-1)
#   For a different Supabase project (e.g. Vercel Marketplace), set all three to match:
#     ABBIEY_SUPABASE_PROJECT_REF=<ref>
#     ABBIEY_SUPABASE_POOLER=aws-1-<region>.pooler.supabase.com   # from Supabase Connect -> Transaction pooler
#     SUPABASE_URL=https://<ref>.supabase.co
#   Then run setup_supabase_env.py so SUPABASE_DB_URL uses postgres.<ref> on port 6543.
#
#   Never change project without: new project, Google OAuth in Supabase, Google Cloud redirect URI
#   for https://<ref>.supabase.co/auth/v1/callback, and python scripts/restore_vercel_env.py --apply
#
# Supabase Auth (login, signup, Google OAuth): set URL + anon key — enables auth in templates.
# App enforces SUPABASE_URL matches https://$ABBIEY_SUPABASE_PROJECT_REF.supabase.co when not under pytest.
# ABBIEY_SUPABASE_PROJECT_REF=xwxscvllmghyogddpmii
SUPABASE_URL=https://xwxscvllmghyogddpmii.supabase.co
# Same URL if you use NEXT_PUBLIC_* anywhere (must match exactly if set):
NEXT_PUBLIC_SUPABASE_URL=https://xwxscvllmghyogddpmii.supabase.co
# SUPABASE_ANON_KEY=eyJ...   (Dashboard → Project Settings → API → anon public — used by Flask templates)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...  (Optional browser alias; keep identical to SUPABASE_ANON_KEY if set)
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  (Dashboard → API → Publishable key — optional; never commit real value)
# SUPABASE_SECRET_KEY=sb_secret_...  (Dashboard → API → Secret key — server-only, optional unless used by tooling)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (Dashboard → API → service_role — KEEP SECRET)
# Used for the `reverse-image-uploads` bucket (image upload → Bing reverse lookup).
# Without it, image upload falls back to requiring SITE_URL on a public HTTPS host.
# SUPABASE_JWT_SECRET=...    (Dashboard → API → JWT Secret — KEEP SECRET)
#
# PostgreSQL — use Transaction pooler for the app / Vercel (port 6543), NOT direct 5432:
# SUPABASE_DB_URL=postgresql://postgres.xwxscvllmghyogddpmii:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql://postgres.xwxscvllmghyogddpmii:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct DB (port 5432) is for local tools only, e.g. supabase db pull / GUI clients:
# postgresql://postgres:YOUR_PASSWORD@db.xwxscvllmghyogddpmii.supabase.co:5432/postgres
#
# Shortcut: python scripts/setup_supabase_env.py  (writes pooler SUPABASE_DB_URL)
# Push to Vercel: python scripts/restore_vercel_env.py --apply
#
# Supabase CLI (optional):  supabase login
#                           supabase init
#                           supabase link --project-ref xwxscvllmghyogddpmii
#
# Google OAuth also requires Google Cloud Console setup — see AGENTS.md "Google Cloud Console" section.
# Reverse image upload limit (bytes) before the request is rejected:
# ABBIEY_REVERSE_IMAGE_MAX_BYTES=4194304
# Optional: OpenWeb Ninja reverse image (api.openwebninja.com) — key as ``x-api-key`` header. If unset, Bing is used.
# OPENWEBNINJA_API_KEY=ak_...
# OPENWEBNINJA_REVERSE_IMAGE_KEY=   # optional alias for the same key
# Max matches from OpenWeb Ninja (1–500, default 40):
# ABBIEY_REVERSE_IMAGE_OPENWEBNINJA_LIMIT=40

# ── Upstash Redis (optional L2 cache — survives cold starts, shared across invocations) ──
# Create a free database at https://console.upstash.com, then copy REST API URL + token.
# UPSTASH_REDIS_REST_URL=https://<id>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
# UPSTASH_SEARCH_TTL=60   # seconds to cache search results in Redis (default: 60)

# ── Turso (alternative to Supabase) ─────────────────────────────────────────────
# LIBSQL_URL=https://xxx.turso.io
# LIBSQL_AUTH_TOKEN=...
# Optional dedicated libSQL endpoint for users/auth data if you split storage:
# LIBSQL_USERS_URL=https://xxx.turso.io

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
# Production-like environment markers / escape hatch:
# ENV=production
# FLASK_ENV=production
# RAILWAY_ENVIRONMENT_NAME=production
# ABBIEY_SKIP_STARTUP_CHECKS=1

# ── Company / registry lookups (optional) ──────────────────────────────────────
# Used for entity/company enrichment when OpenCorporates is enabled:
# OPENCORPORATES_API_TOKEN=oc_xxxxxxxxxxxxxxxxxxxxx

# ── Vercel production (abbieysearch.com) ─────────────────────────────────────
# Set these in the Vercel dashboard for the linked project — not in the repo.
# SECRET_KEY=...
# ADMIN_TOKEN=...
# SUPABASE_DB_URL=postgresql://...pooler...:6543/postgres   (or DATABASE_URL)
# Optional: match Render — BASE_URL=https://abbieysearch.com
