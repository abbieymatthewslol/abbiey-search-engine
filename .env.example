# abbiey.search — environment configuration
#
# EASIEST (local + Supabase): run once — only your DB password needed
#   python scripts/setup_supabase_env.py
#   or double-click: setup_supabase.bat
#
# Or copy this file to .env and edit by hand.

# Flask secret key (generate a random one for production)
SECRET_KEY=change-me-to-something-random-and-long

# Signup email verification (Resend — https://resend.com). Without this, verification emails are not sent
# (OTP + link are logged server-side as a warning). After verifying your domain in Resend, set FROM to match.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=abbiey.search <noreply@yourdomain.com>

# Public site URL (no trailing slash) — used for Open Graph, Twitter cards, and JSON-LD.
# Set in production so link previews match your domain. If unset, the request URL is used
# (use this when behind a reverse proxy without trusted X-Forwarded-* headers).
# SITE_URL=https://www.abbieysearch.com

# ── Google Search Console ─────────────────────────────────────────────────────
# Omit or comment out: use built-in HTML-tag token. Set to a new value to override.
# Set to empty to disable the meta tag: GOOGLE_SITE_VERIFICATION=
# GOOGLE_SITE_VERIFICATION=your-new-token
#
# Strict no-third-party HTML: set both to empty in production.
#   GOOGLE_SITE_VERIFICATION=
#   GOOGLE_ANALYTICS_ID=

# ── Google Analytics 4 (gtag.js) ──────────────────────────────────────────────
# A default measurement ID is built into the app for the public site. Override with your
# own ID, or set empty to omit gtag entirely (recommended for private/self-hosted installs):
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GOOGLE_ANALYTICS_ID=

# ── Stripe Payment Links ──────────────────────────────────────────────────────
# In Stripe Dashboard → each Payment Link → After payment → Redirect to your site:
#   https://YOUR_PUBLIC_DOMAIN/payment-return
# (Same URL for search unlock and API access links — return destination is stored in the browser.)
# Search unlock checkout URL (optional override):
# STRIPE_SEARCH_CHECKOUT_URL=https://buy.stripe.com/your-link
# API keys checkout URL (optional override):
# STRIPE_API_KEYS_CHECKOUT_URL=https://buy.stripe.com/your-link
#
# ── Stripe Webhook (server-side payment verification) ─────────────────────────
# 1. Stripe Dashboard → Developers → Webhooks → Add endpoint
# 2. URL: https://YOUR_PUBLIC_DOMAIN/webhooks/stripe
# 3. Events: checkout.session.completed
# 4. Copy the signing secret (whsec_...) below:
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects /admin/analytics — visit /admin/analytics?token=YOUR_TOKEN
ADMIN_TOKEN=change-me-to-something-secret

# ── Open access (self-host) ───────────────────────────────────────────────────
# Set to 1/true to disable all rate limits — only on networks you trust.
# ABBIEY_OPEN_ACCESS=1
# Max search / chat message length in characters (500–50000, default 8000).
# ABBIEY_MAX_QUERY_LENGTH=8000

# Multi-source retrieval pipeline for web text search (async fan-out, scoring, dedup, optional clusters).
# Set to 0/false/off to use the legacy DDG + thread-pool enrichment path only.
# ABBIEY_RETRIEVAL_PIPELINE=1

# Optional: tune retrieval ranking weights (defaults: 0.25 / 0.35 / 0.40).
# ABBIEY_SCORE_W_FRESHNESS=0.25
# ABBIEY_SCORE_W_AUTHORITY=0.35
# ABBIEY_SCORE_W_SEMANTIC=0.40

# ── Supabase (PostgreSQL) — persistent users, bookmarks, analytics, waitlist ─
#
# Supabase Auth (login, signup, Google OAuth): set BOTH — enables supabase_auth in templates.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_ANON_KEY=eyJ... or sb_publishable_... from Project Settings → API
#
# The dashboard "Publishable" / "Secret" API keys (sb_publishable_*, sb_secret_*)
# are for Supabase JS / GoTrue. Postgres access below uses psycopg2, not those keys.
#
# 1. Supabase → Project Settings → Database
# 2. Under "Connection string", choose URI, mode "Transaction" (pooler) for
#    serverless (Vercel/Render) — usually port 6543 — or "Session" / direct :5432
# 3. Copy the postgresql://... URL and replace [YOUR-PASSWORD] with your DB password
#
# SUPABASE_DB_URL=postgresql://postgres.[ref]:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# (Some hosts use user "postgres" only — use exactly what Supabase shows.)
#
# Alias supported:
# DATABASE_URL=postgresql://...
#
# After restart, logs should show: "Supabase/PostgreSQL connected (host:port)"
# Verify: /admin/api/health?token=YOUR_ADMIN_TOKEN → storage: "supabase", analytics_db: "ok"
#
# Vercel: Project → Settings → Environment Variables — set the same SUPABASE_DB_URL (or DATABASE_URL)
# for Production. Use the Transaction pooler URI (port 6543). Redeploy after saving.

# ── Turso (alternative to Supabase) ─────────────────────────────────────────────
# LIBSQL_URL=https://xxx.turso.io
# LIBSQL_AUTH_TOKEN=...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Vercel production (abbieysearch.com) ─────────────────────────────────────
# Set these in the Vercel dashboard for the linked project — not in the repo.
# SECRET_KEY=...
# ADMIN_TOKEN=...
# SUPABASE_DB_URL=postgresql://...pooler...:6543/postgres   (or DATABASE_URL)
# Optional: match Render — BASE_URL=https://www.abbieysearch.com
