# abbiey.search — environment configuration
#
# EASIEST (local + Supabase): run once — only your DB password needed
#   python scripts/setup_supabase_env.py
#   or double-click: setup_supabase.bat
#
# Or copy this file to .env and edit by hand.

# Flask secret key (generate a random one for production)
SECRET_KEY=change-me-to-something-random-and-long

# Signup email verification (Resend — https://resend.com). Without this, verification emails are not sent
# (OTP + link are logged server-side as a warning). After verifying your domain in Resend, set FROM to match.
# RESEND_API_KEY=re_xxxxxxxx
# EMAIL_FROM=abbiey.search <noreply@yourdomain.com>

# Public site URL (no trailing slash) — used for Open Graph, Twitter cards, JSON-LD, Stripe return
# resolution, and Supabase OAuth / password-reset redirectTo (must match Supabase Auth URL config).
# If unset, the current request origin is used (set SITE_URL on Vercel/production so Google sign-in
# returns to your real domain, not a preview URL).
# SITE_URL=https://www.abbieysearch.com

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for /api/ endpoints.
# Defaults to SITE_URL if unset. Set explicitly in production to avoid open CORS.
# CORS_ALLOWED_ORIGINS=https://www.abbieysearch.com,https://abbieysearch.com

# ── Google Search Console ─────────────────────────────────────────────────────
# Set your domain verification token from Google Search Console → HTML tag method.
# Leave unset or empty to omit the meta tag.
# GOOGLE_SITE_VERIFICATION=your-verification-token

# ── Google Analytics 4 (gtag.js) ──────────────────────────────────────────────
# Set your GA4 measurement ID, or leave unset/empty to omit gtag entirely
# (recommended for private/self-hosted installs):
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ── Stripe Payment Links ──────────────────────────────────────────────────────
# REQUIRED for payment features — no hardcoded defaults.
# In Stripe Dashboard → each Payment Link → After payment → Redirect to your site:
#   https://YOUR_PUBLIC_DOMAIN/payment-return
# Search unlock checkout URL:
STRIPE_SEARCH_CHECKOUT_URL=https://buy.stripe.com/your-link
# API keys checkout URL:
STRIPE_API_KEYS_CHECKOUT_URL=https://buy.stripe.com/your-link
#
# ── Stripe Webhook (server-side payment verification) ─────────────────────────
# 1. Stripe Dashboard → Developers → Webhooks → Add endpoint
# 2. URL: https://YOUR_PUBLIC_DOMAIN/webhooks/stripe
# 3. Events: checkout.session.completed
# 4. Copy the signing secret (whsec_...) below:
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects /admin/analytics — visit /admin/analytics?token=YOUR_TOKEN
ADMIN_TOKEN=change-me-to-something-secret

# ── Feature gates (config-driven, no-redeploy) ────────────────────────────
# Each gate controls who can use a feature:
#   "all"  — available to everyone (default)
#   "paid" — available only to users with a paid/unlocked account
#   "none" — disabled for everyone (kill-switch)
# FEATURE_DEEP_WEB=all
# FEATURE_AI_SUMMARY=all
# FEATURE_AI_CHAT=all
# FEATURE_CODE_SEARCH=all
# FEATURE_VOICE_SEARCH=all

# ── Open access (self-host) ───────────────────────────────────────────────────
# Set to 1/true to disable all rate limits — only on networks you trust.
# ABBIEY_OPEN_ACCESS=1
# Max search / chat message length in characters (500–50000, default 8000).
# ABBIEY_MAX_QUERY_LENGTH=8000

# Multi-source retrieval pipeline for web text search (async fan-out, scoring, dedup, optional clusters).
# Set to 0/false/off to use the legacy DDG + thread-pool enrichment path only.
# ABBIEY_RETRIEVAL_PIPELINE=1

# Optional: tune retrieval ranking weights (defaults: 0.25 / 0.35 / 0.40).
# ABBIEY_SCORE_W_FRESHNESS=0.25
# ABBIEY_SCORE_W_AUTHORITY=0.35
# ABBIEY_SCORE_W_SEMANTIC=0.40

# ── Supabase (PostgreSQL + Auth) — persistent users, bookmarks, analytics ──
#
# ACTIVE PROJECT: xwxscvllmghyogddpmii (Singapore, ap-southeast-1)
#   For a different Supabase project (e.g. Vercel Marketplace), set all three to match:
#     ABBIEY_SUPABASE_PROJECT_REF=<ref>
#     ABBIEY_SUPABASE_POOLER=aws-1-<region>.pooler.supabase.com   # from Supabase Connect -> Transaction pooler
#     SUPABASE_URL=https://<ref>.supabase.co
#   Then run setup_supabase_env.py so SUPABASE_DB_URL uses postgres.<ref> on port 6543.
#
#   Never change project without: new project, Google OAuth in Supabase, Google Cloud redirect URI
#   for https://<ref>.supabase.co/auth/v1/callback, and python scripts/restore_vercel_env.py --apply
#
# Supabase Auth (login, signup, Google OAuth): set URL + anon key — enables auth in templates.
# App enforces SUPABASE_URL matches https://$ABBIEY_SUPABASE_PROJECT_REF.supabase.co when not under pytest.
# ABBIEY_SUPABASE_PROJECT_REF=xwxscvllmghyogddpmii
SUPABASE_URL=https://xwxscvllmghyogddpmii.supabase.co
# Same URL if you use NEXT_PUBLIC_* anywhere (must match exactly if set):
NEXT_PUBLIC_SUPABASE_URL=https://xwxscvllmghyogddpmii.supabase.co
# SUPABASE_ANON_KEY=eyJ...   (Dashboard → Project Settings → API → anon public — used by Flask templates)
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  (Dashboard → API → Publishable key — optional; never commit real value)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  (Dashboard → API → service_role — KEEP SECRET)
# SUPABASE_JWT_SECRET=...    (Dashboard → API → JWT Secret — KEEP SECRET)
#
# PostgreSQL — use Transaction pooler for the app / Vercel (port 6543), NOT direct 5432:
# SUPABASE_DB_URL=postgresql://postgres.xwxscvllmghyogddpmii:PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Direct DB (port 5432) is for local tools only, e.g. supabase db pull / GUI clients:
# postgresql://postgres:YOUR_PASSWORD@db.xwxscvllmghyogddpmii.supabase.co:5432/postgres
#
# Shortcut: python scripts/setup_supabase_env.py  (writes pooler SUPABASE_DB_URL)
# Push to Vercel: python scripts/restore_vercel_env.py --apply
#
# Supabase CLI (optional):  supabase login
#                           supabase init
#                           supabase link --project-ref xwxscvllmghyogddpmii
#
# Google OAuth also requires Google Cloud Console setup — see AGENTS.md "Google Cloud Console" section.

# ── Turso (alternative to Supabase) ─────────────────────────────────────────────
# LIBSQL_URL=https://xxx.turso.io
# LIBSQL_AUTH_TOKEN=...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── Vercel production (abbieysearch.com) ─────────────────────────────────────
# Set these in the Vercel dashboard for the linked project — not in the repo.
# SECRET_KEY=...
# ADMIN_TOKEN=...
# SUPABASE_DB_URL=postgresql://...pooler...:6543/postgres   (or DATABASE_URL)
# Optional: match Render — BASE_URL=https://www.abbieysearch.com
