# abbiey.search — environment configuration
#
# EASIEST (local + Supabase): run once — only your DB password needed
#   python scripts/setup_supabase_env.py
#   or double-click: setup_supabase.bat
#
# Or copy this file to .env and edit by hand.

# Flask secret key (generate a random one for production)
SECRET_KEY=change-me-to-something-random-and-long

# ── Google Search Console ─────────────────────────────────────────────────────
# Omit or comment out: use built-in HTML-tag token. Set to a new value to override.
# Set to empty to disable the meta tag: GOOGLE_SITE_VERIFICATION=
# GOOGLE_SITE_VERIFICATION=your-new-token

# ── Google Analytics 4 (gtag.js) ──────────────────────────────────────────────
# Default measurement ID is built in. Override or disable with empty:
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
# GOOGLE_ANALYTICS_ID=

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects /admin/analytics — visit /admin/analytics?token=YOUR_TOKEN
ADMIN_TOKEN=change-me-to-something-secret

# ── Open access (self-host) ───────────────────────────────────────────────────
# Set to 1/true to disable all rate limits — only on networks you trust.
# ABBIEY_OPEN_ACCESS=1
# Max search / chat message length in characters (500–50000, default 8000).
# ABBIEY_MAX_QUERY_LENGTH=8000

# ── Supabase (PostgreSQL) — persistent users, bookmarks, analytics, waitlist ─
# Optional: project URL (dashboard / future REST client). Not used for DB by Flask.
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
#
# The dashboard "Publishable" / "Secret" API keys (sb_publishable_*, sb_secret_*)
# are for Supabase JS / REST. This Flask app needs the DATABASE connection string.
#
# 1. Supabase → Project Settings → Database
# 2. Under "Connection string", choose URI, mode "Transaction" (pooler) for
#    serverless (Vercel/Render) — usually port 6543 — or "Session" / direct :5432
# 3. Copy the postgresql://... URL and replace [YOUR-PASSWORD] with your DB password
#
# SUPABASE_DB_URL=postgresql://postgres.[ref]:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# (Some hosts use user "postgres" only — use exactly what Supabase shows.)
#
# Alias supported:
# DATABASE_URL=postgresql://...
#
# After restart, logs should show: "Supabase/PostgreSQL connected (host:port)"
# Verify: /admin/api/health?token=YOUR_ADMIN_TOKEN → storage: "supabase", analytics_db: "ok"

# ── Turso (alternative to Supabase) ─────────────────────────────────────────────
# LIBSQL_URL=https://xxx.turso.io
# LIBSQL_AUTH_TOKEN=...

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
