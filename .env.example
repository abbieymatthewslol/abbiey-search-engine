# Copy this file to .env and fill in your values.
# abbiey.search — environment configuration

# Flask secret key (generate a random one for production)
SECRET_KEY=change-me-to-something-random-and-long

# ── Stripe ────────────────────────────────────────────────────────────────────
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...

# Create a Product + Price in Stripe Dashboard, then paste the Price ID here
# (e.g. price_1ABC123...)
STRIPE_PRICE_ID=price_...

# Webhook signing secret — from Stripe Dashboard → Webhooks → your endpoint
# Set the webhook URL to: https://yourdomain.com/webhook
# Events to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── URLs ──────────────────────────────────────────────────────────────────────
# Public base URL (no trailing slash). Used for Stripe success/cancel redirects.
# Local dev:
BASE_URL=http://localhost:8000
# Production:
# BASE_URL=https://abbiey.search

# ── Admin ─────────────────────────────────────────────────────────────────────
# Protects /admin/analytics — visit /admin/analytics?token=YOUR_TOKEN
ADMIN_TOKEN=change-me-to-something-secret

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
